---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectTeaser from '../components/ProjectTeaser.astro';
import ProductReel from '../components/home/ProductReel.astro';
import ProductMindset from '../components/home/ProductMindset.astro';
import AboutSection from '../components/home/AboutSection.astro';
import { projects } from '../data/projects';
---
<BaseLayout motion={false}>
  <div class="home-page">
    <Header />
    <main id="main-content" tabindex="-1">
      <section id="home-hero" class="home-hero wrap" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <p class="hero-identity">Fausta Raihan Maulana</p>
          <h1 id="hero-heading">Hi I'm Fausta<em>Product Engineer.</em></h1>
          <p class="hero-introduction">Connecting product thinking, design, and code<br class="desktop-break" /> to build software people can use.</p>
          <a class="hero-action" href="#work">Explore my work <span aria-hidden="true">↘</span></a>
        </div>
        <nav class="project-index" aria-label="Project shortcuts"><p>A few things<br /> I’m building</p>{projects.map(project => <a href={`#project-${project.slug}`} aria-label={project.name}><img src={project.home.logo.src} alt="" width={project.home.logo.width} height={project.home.logo.height} />{!project.home.logo.wordmark && <span>{project.name === 'Karisma AI' ? project.name : project.name.toLowerCase()}</span>}</a>)}</nav>
      </section>
      <ProductReel />
      <ProductMindset />
      <section id="work" class="home-work" aria-labelledby="work-heading">
        <div class="wrap"><div class="home-work-heading"><p class="section-note">Products, thoughtfully built.</p><h2 id="work-heading">Selected works.</h2></div><div class="work-gallery">{projects.map(project => <ProjectTeaser project={project} />)}</div></div>
      </section>
      <AboutSection />
      <section id="contact" class="home-contact" aria-labelledby="contact-heading"><div class="contact-layout wrap"><div><p class="contact-eyebrow">Good things start with a conversation</p><h2 id="contact-heading">Let’s build something<em>worth using.</em></h2></div><div class="contact-details"><p>Have a product idea or an engineering opportunity? I’d love to hear about it.</p><a class="button button-primary contact-email" href="mailto:faustaraihan69@gmail.com">faustaraihan69@gmail.com <span aria-hidden="true">↗</span></a></div></div></section>
    </main>
    <Footer />
  </div>
</BaseLayout>
