---
interface Props {
  cvUrl?: string | null;
}

// The existing public PDF is checked by check:content; null omits the action.
const { cvUrl = '/fausta-raihan-maulana-cv.pdf' } = Astro.props;
---
<footer id="footer" class:list={["site-footer", { "site-footer--sky": Astro.url.pathname.startsWith("/work/") }]} aria-label="Footer">
  <div class="footer-inner wrap">
    <div class="footer-top">
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        {cvUrl && <a href={cvUrl}>Download CV</a>}
        <a href="/#contact">Contact</a>
      </nav>
      <p class="footer-copyright">© {new Date().getFullYear()} Fausta Raihan Maulana</p>
    </div>
    <p class="footer-signature" aria-hidden="true">Fausta Raihan</p>
  </div>
</footer>
