---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectTeaser from '../components/ProjectTeaser.astro';
import { projects } from '../data/projects';
---
<BaseLayout>
  <Header />
  <main id="main-content" tabindex="-1">
    <section class="intro wrap">
      <div class="intro-scene">
        <p class="intro-note">Independent mind.<br />Thoughtful software.</p>
        <div class="scene-object" aria-hidden="true">
          <div class="sculpture">{Array.from({length:6}, (_,i) => <i class="capsule" style={`--i:${i}`}></i>)}</div>
        </div>
        <p class="scene-caption">A few ideas,<br />coming together.</p>
        <div class="orbit-object" data-ornament aria-hidden="true"><i></i><i></i><i></i></div>
        <h1 class="scene-title"><span class="title-line">Fausta Raihan</span><span class="title-line">Maulana<span class="name-period">.</span></span></h1>
      </div>
      <div class="intro-bottom"><p>Software developer with a product mindset.<br />Based in Semarang, Indonesia.</p><a class="text-link" href="#work">Explore my work <span aria-hidden="true">↓</span></a><button class="motion-toggle" data-motion-toggle aria-pressed="false" hidden><span data-motion-label>Motion on</span></button></div>
    </section>

    <section class="statement-section wrap" data-reveal>
      <p class="section-marker">A note from Fausta</p>
      <div class="statement-grid">
        <h2>A curious mind.<br /><em>A practical touch.</em></h2>
        <p>I care about the space where product thinking meets implementation: understanding the person on the other side, making the flow clear, then building the details so the idea holds up in use.</p>
      </div>
    </section>

    <section id="work" class="work-section wrap anchor-section">
      <div class="section-heading" data-reveal>
        <div><p class="section-marker">01 / Selected work</p><h2>Selected<br /><em>work.</em></h2></div>
        <svg class="work-flower" data-ornament aria-hidden="true" width="150" height="150" viewBox="0 0 100 100"><g fill="#258f95">{Array.from({length:8}, (_, i) => <rect x="41" y="3" width="18" height="94" rx="9" transform={`rotate(${i * 22.5} 50 50)`} />)}</g></svg>
        <p class="section-aside">Four projects across career tools, developer utilities, and a farm experience in progress.</p>
      </div>
      <div class="project-list">
        {projects.map((project, index) => <ProjectTeaser project={project} index={index} featured={index === 0} />)}
      </div>
    </section>

    <section id="about" class="about-section wrap anchor-section" data-reveal>
      <div class="section-heading compact-heading"><p class="section-marker">02 / A little about me</p><h2>Curious by default.<br /><em>Practical by choice.</em></h2></div>
      <div class="about-grid">
        <div class="about-copy">
          <p>I’m Fausta Raihan Maulana, a Computer Engineering graduate from Diponegoro University based in Semarang Regency, Indonesia. I build web applications with a product mindset: understanding who they’re for, shaping the experience, and connecting the pieces into maintainable software.</p>
          <p>My experience spans full-stack and mobile development, cross-functional collaboration, and visual design. I’m interested in software engineering opportunities where technical execution and thoughtful product decisions go together.</p>
          <a class="text-link" href="mailto:faustaraihan69@gmail.com">Start a conversation <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/fausta-raihan-maulana-cv.pdf">Download CV <span aria-hidden="true">↗</span></a>
        </div>
        <div class="capability-grid">
          <div class="capability-block"><p class="eyebrow">Frontend</p><p>React<br />TypeScript<br />JavaScript<br />HTML / CSS<br />Tailwind CSS</p></div>
          <div class="capability-block"><p class="eyebrow">Application</p><p>Node.js<br />Express.js<br />PostgreSQL<br />REST APIs</p></div>
          <div class="capability-block"><p class="eyebrow">Product + team</p><p>UI/UX planning<br />Figma<br />Git<br />Cross-functional work</p></div>
        </div>
      </div>
      <div class="education-strip"><span>Education</span><strong>B.Eng. in Computer Engineering, Diponegoro University</strong><span>2022–2026 · GPA 3.77/4.00</span></div>
    </section>

    <section id="experience" class="experience-section wrap anchor-section" data-reveal>
      <div class="section-heading compact-heading"><p class="section-marker">03 / Experience</p><h2>Learning through<br /><em>shipping.</em></h2></div>
      <div class="experience-list">
        <article class="experience-item"><div class="experience-year">2026</div><div><h3>Coding Camp powered by DBS Foundation</h3><p class="experience-role">Full-Stack Developer Cohort · Apprenticeship · Feb–Jul 2026</p><p>Graduated with Distinction in the top 10% of 2,800+ participants. Collaborated with a six-person team on Karisma AI, contributing to database design, UI/UX planning, and full-stack integration.</p></div><span class="experience-arrow" aria-hidden="true">↗</span></article>
        <article class="experience-item"><div class="experience-year">2024–25</div><div><h3>Bangkit Academy led by Google, Tokopedia, Gojek, & Traveloka</h3><p class="experience-role">Mobile Development Cohort · Apprenticeship · Sep 2024–Jan 2025</p><p>Completed a mobile development program covering Kotlin, MVVM, REST APIs, and on-device machine learning. Led a seven-person team across mobile, machine learning, and cloud development to deliver Cashbox.</p></div><span class="experience-arrow" aria-hidden="true">↗</span></article>
        <article class="experience-item"><div class="experience-year">2024</div><div><h3>Dinas Komunikasi dan Informatika Kota Salatiga</h3><p class="experience-role">Software Engineer Intern · Jul–Aug 2024</p><p>Designed 17 QuickCount mobile screens in Figma and translated the prototypes into Android XML layouts. Worked on requirements, implementation, and technical handoff with stakeholders and a development teammate.</p></div><span class="experience-arrow" aria-hidden="true">↗</span></article>
      </div>
      <p class="leadership-note"><span class="eyebrow">Also</span> Previously led the Public Relations Division at HIMASKOM, coordinating teams, external communication, and knowledge-sharing initiatives.</p>
    </section>

    <section id="contact" class="contact-section wrap anchor-section" data-reveal>
      <div class="contact-loop" data-ornament aria-hidden="true"></div>
      <p class="section-marker">04 / Contact</p>
      <div class="contact-inner">
        <h2>Let’s make something<br /><em>useful.</em></h2>
        <p>Let’s talk about software, product ideas, or opportunities to work together.</p>
        <a class="contact-link" href="mailto:faustaraihan69@gmail.com">faustaraihan69@gmail.com <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
