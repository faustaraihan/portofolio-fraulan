---
import type { Locale } from '../../i18n/routes.ts';
import { ui } from '../../i18n/ui.ts';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = ui[locale];
const columns = [
  [
    { file: 'codestroke-typing', width: 408, height: 230, alt: copy.reelCodestrokeTypingAlt },
    { file: 'blastrot-daily', width: 408, height: 250, alt: copy.reelBlastrotDailyAlt },
    { file: 'boilrplate-blocks', width: 408, height: 252, alt: copy.reelBoilrplateBlocksAlt },
    { file: 'karisma-login', width: 408, height: 280, alt: copy.reelKarismaLoginAlt },
  ],
  [
    { file: 'karisma-landing', width: 408, height: 230, alt: copy.reelKarismaLandingAlt },
    { file: 'codestroke-learn', width: 408, height: 300, alt: copy.reelCodestrokeLearnAlt },
    { file: 'blastrot-pair-pop', width: 408, height: 260, alt: copy.reelBlastrotPairPopAlt },
    { file: 'boilrplate-project', width: 408, height: 222, alt: copy.reelBoilrplateProjectAlt },
  ],
  [
    { file: 'boilrplate-revision', width: 408, height: 255, alt: copy.reelBoilrplateRevisionAlt },
    { file: 'karisma-analysis', width: 408, height: 390, alt: copy.reelKarismaAnalysisAlt },
    { file: 'codestroke-leaderboard', width: 408, height: 210, alt: copy.reelCodestrokeLeaderboardAlt },
    { file: 'blastrot-stickers', width: 408, height: 157, alt: copy.reelBlastrotStickersAlt },
  ],
];
---
<section id="product-reel" class="product-reel wrap" aria-label={copy.reelLabel}>
  <div class="reel-wall">
    {columns.map(column => <div class="reel-column">{column.map(tile => <img data-reel-tile src={`/images/pendev/reel-${tile.file}-tile.webp`} alt={tile.alt} width={tile.width} height={tile.height} loading="lazy" decoding="async" />)}</div>)}
    <div class="reel-veil" aria-hidden="true"></div>
    <a class="reel-action" href="#work"><img src="/images/pendev/fraulan-mark.svg" alt="" width="42" height="42" /><span>{copy.exploreWork}<small>{copy.reelActionSubtitle}</small></span><span aria-hidden="true">↘</span></a>
  </div>
  <p class="reel-caption">{copy.reelCaption}</p>
</section>
