---
import type { Project } from '../data/projects';
import type { Locale } from '../i18n/routes.ts';
import { ui } from '../i18n/ui.ts';
interface Props { project: Project; locale?: Locale; }
const { project, locale = 'en' } = Astro.props;
const copy = ui[locale];
const { home } = project;
---
<article id={`project-${project.slug}`} class="work-card" data-work-card>
  {project.caseStudyPath ? <a class="work-card-media" href={project.caseStudyPath} aria-label={copy.projectExploreLabel.replace('{project}', project.name)}>
    <img src={home.preview.src} alt={home.preview.alt} width={home.preview.width} height={home.preview.height} loading="lazy" decoding="async" />
  </a> : <div class="work-card-media"><img src={home.preview.src} alt={home.preview.alt} width={home.preview.width} height={home.preview.height} loading="lazy" decoding="async" /></div>}
  <div class="work-card-heading">
    <h3>{project.caseStudyPath ? <a href={project.caseStudyPath}>{project.name}</a> : project.name}</h3>
    <div class="work-card-tags"><span>{home.category}</span><span>{home.label}</span></div>
  </div>
  <p class="work-card-summary">{home.summary}</p>
  <p class="work-card-caption">{home.caption}</p>
</article>
