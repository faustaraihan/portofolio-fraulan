---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  motion?: boolean;
  noindex?: boolean;
}

const {
  title = 'Fausta Raihan Maulana | Product Engineer',
  description = 'Fausta Raihan Maulana connects product thinking, design, and code to build software people can use.',
  canonical,
  ogImage = '/og/fraulan.png',
  motion = false,
  noindex = import.meta.env.DEV || import.meta.env.PUBLIC_NOINDEX === 'true',
} = Astro.props;
const canonicalUrl = canonical ?? Astro.url.pathname;
const absoluteCanonical = new URL(canonicalUrl, Astro.site ?? 'https://fraulan.com').toString();
const absoluteOg = new URL(ogImage, Astro.site ?? 'https://fraulan.com').toString();
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Fausta Raihan Maulana',
  url: 'https://fraulan.com/',
  email: 'mailto:faustaraihan69@gmail.com',
  sameAs: ['https://www.linkedin.com/in/faustaraihan', 'https://github.com/faustaraihan', 'https://www.instagram.com/faustaraihan/'],
};
---
<!doctype html>
<html lang="en" data-motion={motion ? undefined : 'static'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fcfdfe" />
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteCanonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:site_name" content="fraulan.com" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Fausta Raihan Maulana — fraulan.com, with selected work from Codestroke, Blastrot, Karisma AI, and Boilrplate." />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />
    <meta name="twitter:image:alt" content="Fausta Raihan Maulana — fraulan.com, with selected work from Codestroke, Blastrot, Karisma AI, and Boilrplate." />
    <link rel="preload" href="/fonts/dm-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg?v=20261030" type="image/svg+xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
