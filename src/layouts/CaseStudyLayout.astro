---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CaseStudyNav from '../components/case-studies/CaseStudyNav.astro';
import { getProject } from '../data/projects';
import type { Locale } from '../i18n/routes.ts';
import { homeHref } from '../i18n/routes.ts';
import { ui } from '../i18n/ui.ts';

const slug = Astro.props.frontmatter?.project ?? Astro.props.project;
const locale: Locale = Astro.props.frontmatter?.locale ?? Astro.props.locale ?? 'en';
const copy = ui[locale];
const project = getProject(slug, locale);
if (!project) throw new Error(`Unknown project: ${slug}`);
const description = `${project.name}: ${project.summary}`;
const study = project.study;
---
<BaseLayout locale={locale} title={copy.casePageTitle.replace('{project}', project.name)} description={description} motion={!study}>
  <div class:list={["case-page", { "case-page--designed": !!study }]} >
  <Header locale={locale} />
  <main id="main-content" class:list={['case-study', `case-${project.slug}`]} tabindex="-1">
    {study ? <section class="case-overview wrap" aria-label={copy.projectOverviewLabel.replace('{project}', project.name)}>
      <nav class="case-location" aria-label={copy.breadcrumbLabel}><a class="case-breadcrumb" href={homeHref(locale, 'work')}><span class="case-back-surface"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m7-7-7 7 7 7" /></svg><span>{copy.backToWork}</span></span></a><span class="case-location-current" aria-current="page">{project.name}</span></nav>
      <div class="case-identity">
        <div><p class="case-eyebrow">{study.eyebrow}</p><h1 class="case-wordmark">{study.logo ? <><span class="case-sr-only">{project.name}</span><img src={study.logo.src} alt="" width={study.logo.width} height={study.logo.height} /></> : project.name}</h1><p class="case-promise">{study.deck}</p><p class="case-description">{study.description}</p></div>
        {study.identityArt && <img class="case-identity-art" src={study.identityArt.src} alt="" width={study.identityArt.width} height={study.identityArt.height} decoding="async" />}
        {project.demoUrl && study.showLiveAction !== false && <a class="button button-primary case-live" href={project.demoUrl}>{copy.openProduct} <span aria-hidden="true">↗</span></a>}
      </div>
      <dl class="case-context"><div><dt>{study.roleLabel ?? copy.myRole}</dt><dd>{study.role}</dd></div><div><dt>{study.focusLabel ?? copy.focusLabel}</dt><dd>{study.focus}</dd></div><div><dt>{study.contextLabel ?? copy.contextLabel}</dt><dd>{study.context}</dd></div></dl>
      <div class:list={["case-product-overview", { "has-flow": !!study.flow }]}>
        {study.overview.label && <p class="case-overview-label case-eyebrow">{study.overview.label}</p>}
        <div class:list={["case-overview-media", { "case-overview-media--scrollable": study.overview.scrollable }]} tabindex={study.overview.scrollable ? "0" : undefined} role={study.overview.scrollable ? "region" : undefined} aria-label={study.overview.scrollable ? copy.projectConceptLabel.replace('{project}', project.name) : undefined}><img class="case-overview-image" src={study.overview.src} alt={study.overview.alt} width={study.overview.width} height={study.overview.height} decoding="async" fetchpriority="high" /></div>
        {(study.flow || study.overview.summary || study.overview.caption) && <div class="case-overview-details">{study.overview.summary && <p class="case-overview-summary">{study.overview.summary}</p>}{study.flow && <><p class="case-eyebrow">{copy.coreUserFlow}</p><ol class="case-core-flow">{study.flow.map((step,index) => <li><span aria-hidden="true">0{index+1}</span><h2>{step.title}</h2><p>{step.description}</p></li>)}</ol></>}{study.overview.caption && <p class="case-overview-caption">{study.overview.caption}</p>}</div>}
      </div>
      <nav class="case-chapters" aria-label={copy.studyContents}><span>{copy.studyContents}</span>{study.chapters.map(chapter => <a href={`#${chapter.id}`}>{chapter.label}</a>)}</nav>
    </section> : <>
    <section class="case-hero wrap" data-reveal>
      <a class="back-link" href={homeHref(locale, 'work')}><span aria-hidden="true">←</span> Back to selected work</a>
      <button class="motion-toggle case-motion" data-motion-toggle aria-pressed="false" hidden><span data-motion-label>Motion on</span></button>
      <div class="case-intro-grid">
        <div>
          <p class="eyebrow">{project.eyebrow}</p>
          <h1 class="project-title"><span class="project-title-text">{project.name}</span>{project.logo && <span class:list={['title-emblem', `emblem-${project.slug}`]} aria-hidden="true"><img src={project.logo} alt="" width="100" height="100" /></span>}</h1>
          <p class="case-deck">{project.summary}</p>
        </div>
        <dl class="case-meta">
          <div><dt>{project.contributionLabel}</dt><dd>{project.contribution}</dd></div>
          <div><dt>Stack</dt><dd>{project.stack.join(' · ')}</dd></div>
        </dl>
      </div>
    </section>
    <section class="case-cover wrap" data-reveal>
      <div class="case-cover-label"><span class="eyebrow">A closer look / {project.name}</span><span aria-hidden="true">↓</span></div>
      <div class:list={["case-cover-frame", project.accent]}>
        <img src={project.cover} alt={project.coverAlt} width={project.coverWidth} height={project.coverHeight} loading="eager" decoding="async" />
      </div>
      <div class="case-orbit" data-ornament aria-hidden="true"><i></i><i></i></div>
    </section>
    </>}
    <article class:list={["case-body", study ? "case-body--designed" : "wrap prose"]}>
      <slot />
      {!study && <div class="case-actions">
        {project.demoUrl && <a class="button button-primary" href={project.demoUrl} rel="noopener noreferrer">Visit live project <span aria-hidden="true">↗</span></a>}
        <a class="button button-secondary" href={homeHref(locale, 'work')}>Back to work <span aria-hidden="true">↗</span></a>
      </div>}
    </article>
    <CaseStudyNav currentSlug={project.slug} locale={locale} />
  </main>
  <Footer locale={locale} />
  </div>
</BaseLayout>
