---
import type { Locale } from '../i18n/routes.ts';
import { homeHref, localizePath } from '../i18n/routes.ts';
import { ui } from '../i18n/ui.ts';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = ui[locale];
const targetLocale: Locale = locale === 'en' ? 'id' : 'en';
// The translated case-study routes join the switcher in Task 4.
const showLanguageSwitch = Astro.url.pathname === '/' || Astro.url.pathname === '/id/';
---
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={homeHref(locale)} aria-label={copy.homeLabel}>
      <img src="/images/pendev/fraulan-mark.svg" alt="" width="36" height="36" />
    </a>
    <nav class:list={['desktop-nav', { 'has-language-switch': showLanguageSwitch }]} aria-label={copy.primaryNavigation}>
      <a class="nav-link" href={homeHref(locale, 'work')}>{copy.navWork}</a>
      <a class="nav-link" href={homeHref(locale, 'about')}>{copy.navAbout}</a>
      {showLanguageSwitch && <a class="language-switch" href={localizePath(Astro.url.pathname, targetLocale)} hreflang={targetLocale} aria-label={targetLocale === 'id' ? copy.languageIndonesian : copy.languageEnglish} title={targetLocale === 'id' ? copy.languageIndonesian : copy.languageEnglish}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h12M9 3v2M5 5c0 6 3 9 8 11M13 5c-1 5-4 9-9 12M14 21l4-10 4 10M15.5 17h5" /></svg>
        <span>{locale.toUpperCase()}</span>
      </a>}
      <a class="nav-contact" href={homeHref(locale, 'contact')}><span>{copy.navContact}</span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
    </nav>
  </div>
</header>
